# Maverick — environment template. Copy to .env for local dev.
# NEVER commit real values. Production values live in Koyeb env vars only.

# --- Supabase (new key model) ---
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx          # backend only
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx    # safe for browser

# --- Telegram ---
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=123456789
TELEGRAM_WEBHOOK_SECRET=long-random-string-used-in-setWebhook

# --- Deriv ---
# Your OWN registered application id: api.deriv.com → Dashboard → Register
# application. An unregistered id makes the WebSocket handshake fail with
# HTTP 401 and no market data ever arrives.
DERIV_APP_ID=
# Demo/live account tokens are NOT env vars: they are stored encrypted in the
# Supabase `secrets` table via the dashboard/API, using ENCRYPTION_KEY.

# --- Crypto ---
# 32-byte urlsafe base64 Fernet key. Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# --- App ---
APP_ENV=dev                 # dev | prod
DASHBOARD_PASSWORD=         # optional; when set, mutating /api calls need Authorization: Bearer <value>
